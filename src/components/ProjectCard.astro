---
import { Image } from 'astro:assets';
import type { Project } from '../config/site';

interface Props extends Project {
  /**
   * Visuel du projet. Importe l'image depuis `src/assets/` dans la page appelante
   * (`import shot from '../assets/projet.png'`) pour bénéficier de l'optimisation
   * `astro:assets`. Sans image, une vignette décorative CSS est affichée.
   */
  image?: ImageMetadata;
  imageAlt?: string;
}

const { title, description, tags, repoUrl, demoUrl, image, imageAlt } = Astro.props;
const primaryUrl = demoUrl ?? repoUrl;
---

<article
  class="group flex flex-col overflow-hidden rounded-xl border border-ink-100 bg-white transition-shadow hover:shadow-lg hover:shadow-ink-900/5"
>
  {
    image ? (
      <Image
        src={image}
        alt={imageAlt ?? `Aperçu du projet ${title}`}
        widths={[400, 800]}
        sizes="(min-width: 640px) 400px, 100vw"
        loading="lazy"
        decoding="async"
        class="aspect-16/10 w-full object-cover"
      />
    ) : (
      <div
        aria-hidden="true"
        class="aspect-16/10 w-full bg-linear-to-br from-accent-400/25 via-ink-100 to-ink-100"
      />
    )
  }

  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-lg font-semibold tracking-tight">
      {
        primaryUrl ? (
          <a
            href={primaryUrl}
            rel="noopener noreferrer"
            target="_blank"
            class="transition-colors group-hover:text-accent-600"
          >
            {title}
          </a>
        ) : (
          title
        )
      }
    </h3>

    <p class="mt-2 flex-1 text-sm text-pretty text-ink-700">{description}</p>

    <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Technologies utilisées">
      {
        tags.map((tag) => (
          <li class="rounded-md bg-ink-100 px-2 py-1 text-xs font-medium text-ink-700">
            {tag}
          </li>
        ))
      }
    </ul>

    <div class="mt-5 flex gap-4 text-sm font-medium">
      {
        demoUrl && (
          <a
            href={demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent-600 underline underline-offset-4"
          >
            Démo <span class="sr-only">de {title}</span>
          </a>
        )
      }
      {
        repoUrl && (
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink-700 underline underline-offset-4 hover:text-ink-900"
          >
            Code source <span class="sr-only">de {title}</span>
          </a>
        )
      }
    </div>
  </div>
</article>
