---
import { SKILLS } from '../config/site';
---

<div class="grid gap-8 sm:grid-cols-3">
  {
    SKILLS.map((group) => (
      <div>
        <h3 class="text-sm font-semibold tracking-wide text-ink-500 uppercase">
          {group.title}
        </h3>
        <ul class="mt-4 flex flex-wrap gap-2">
          {group.items.map((item) => (
            <li class="rounded-full border border-ink-100 bg-white px-3 py-1.5 text-sm text-ink-700">
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
