---
import { SITE } from '../config/site';

const links = [
  { href: '#apropos', label: 'À propos' },
  { href: '#projets', label: 'Projets' },
  { href: '#contact', label: 'Contact' },
];
---

<header
  class="sticky top-0 z-40 border-b border-ink-100/80 bg-ink-50/85 backdrop-blur-sm"
>
  <div class="mx-auto flex h-16 w-full max-w-5xl items-center justify-between px-5 sm:px-8">
    <a href="/" class="text-base font-semibold tracking-tight">
      {SITE.name}
    </a>

    <nav aria-label="Navigation principale" class="hidden sm:block">
      <ul class="flex items-center gap-8 text-sm font-medium text-ink-700">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-accent-600">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      type="button"
      id="menu-toggle"
      class="-mr-2 inline-flex size-10 items-center justify-center rounded-md text-ink-700 sm:hidden"
      aria-controls="menu-mobile"
      aria-expanded="false"
    >
      <span class="sr-only">Ouvrir le menu</span>
      <svg
        class="size-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>

  <nav
    id="menu-mobile"
    aria-label="Navigation mobile"
    hidden
    class="border-t border-ink-100 bg-ink-50 sm:hidden"
  >
    <ul class="mx-auto flex max-w-5xl flex-col px-5 py-2 text-base font-medium">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="block py-3 text-ink-700">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-mobile');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.querySelector('span')!.textContent = open ? 'Fermer le menu' : 'Ouvrir le menu';
    };

    toggle.addEventListener('click', () => {
      setOpen(menu.hidden);
    });

    // Referme le menu après navigation vers une ancre.
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
