---
interface Props {
  /** Nombre de frames de la séquence dans /public/image. */
  frameCount?: number;
}

const { frameCount = 240 } = Astro.props;
---

{/* Séquence d'images pilotée par le scroll, fixée derrière le contenu.
    Conservé mais non utilisé : le design est passé sur fond uni. */}
<div class="fixed inset-0 z-0" data-frame-count={frameCount} aria-hidden="true">
  <canvas id="sequence-canvas" class="block h-full w-full"></canvas>
  <div class="absolute inset-0 bg-gradient-to-r from-ink-950 via-ink-950/85 to-ink-950/55">
  </div>
</div>

<script>
  const layer = document.querySelector<HTMLElement>('[data-frame-count]');
  const canvasEl = document.getElementById('sequence-canvas');

  if (layer && canvasEl instanceof HTMLCanvasElement) {
    const canvas = canvasEl;
    const ctx = canvas.getContext('2d', { alpha: false })!;
    const frameCount = Number(layer.dataset.frameCount ?? 0);
    const src = (i: number) =>
      `/image/ezgif-frame-${String(i + 1).padStart(3, '0')}.jpg`;

    const frames: (HTMLImageElement | undefined)[] = new Array(frameCount);
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let target = 0; // frame visé par le scroll
    let current = 0; // frame réellement affiché (lissé)
    let drawn = -1;
    let running = false;

    /* ---- Chargement ---- */
    /** Requêtes menées de front : au-delà, le réseau devient le goulot et
        les frames proches du scroll attendent derrière des frames lointaines. */
    const CONCURRENCY = 8;
    const requested: boolean[] = new Array(frameCount).fill(false);

    function load(i: number, priority: 'high' | 'auto' = 'auto'): Promise<void> {
      requested[i] = true;
      return new Promise((resolve) => {
        const img = new Image();
        img.decoding = 'async';
        img.fetchPriority = priority;
        img.onload = () => {
          // Décodage avant stockage : `drawImage` ne bloque plus le thread principal.
          const done = () => {
            frames[i] = img;
            resolve();
          };
          img.decode().then(done, done);
        };
        img.onerror = () => resolve();
        img.src = src(i);
      });
    }

    /** Frame chargée la plus proche : évite tout trou visuel pendant le préchargement. */
    function nearestLoaded(i: number): HTMLImageElement | undefined {
      if (frames[i]) return frames[i];
      for (let d = 1; d < frameCount; d++) {
        if (frames[i - d]) return frames[i - d];
        if (frames[i + d]) return frames[i + d];
      }
      return undefined;
    }

    /* ---- Rendu ---- */
    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const { width, height } = canvas.getBoundingClientRect();
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      drawn = -1;
      draw(Math.round(current));
      updateTarget();
    }

    function draw(index: number) {
      const img = nearestLoaded(index);
      if (!img) return;
      if (index === drawn) return;
      drawn = index;

      const cw = canvas.width;
      const ch = canvas.height;
      // cover : on remplit le cadre sans déformer l'image
      const scale = Math.max(cw / img.naturalWidth, ch / img.naturalHeight);
      const w = img.naturalWidth * scale;
      const h = img.naturalHeight * scale;
      ctx.drawImage(img, (cw - w) / 2, (ch - h) / 2, w, h);
    }

    /* ---- Scroll : la séquence est répartie sur toute la hauteur de la page ---- */
    function updateTarget() {
      const doc = document.documentElement;
      const distance = doc.scrollHeight - window.innerHeight;
      const progress = distance > 0 ? window.scrollY / distance : 0;
      const clamped = Math.min(1, Math.max(0, progress));
      target = clamped * (frameCount - 1);
      if (!running) {
        running = true;
        requestAnimationFrame(tick);
      }
    }

    /* Interpolation exponentielle : absorbe les à-coups de la molette
       et donne un défilement d'images fluide même en scroll saccadé. */
    function tick() {
      const delta = target - current;
      if (reduceMotion || Math.abs(delta) < 0.01) {
        current = target;
        running = false;
      } else {
        current += delta * 0.15;
        requestAnimationFrame(tick);
      }
      draw(Math.round(current));
    }

    window.addEventListener('scroll', updateTarget, { passive: true });
    window.addEventListener('resize', resize);

    /* ---- Préchargement : du grossier vers le fin ----
       Une passe 1/16 (15 images) couvre déjà toute la plage de scroll : la
       séquence répond dès les premières secondes, puis les passes suivantes
       comblent les trous jusqu'à l'animation complète. Charger dans l'ordre
       0,1,2… laisserait au contraire tout le bas de page sans image. */
    function passes(): number[][] {
      const out: number[][] = [];
      for (let stride = 16; stride >= 1; stride = stride >> 1) {
        const pass: number[] = [];
        for (let i = 0; i < frameCount; i += stride) pass.push(i);
        out.push(pass);
      }
      return out;
    }

    /** Dans une passe, on sert toujours la frame la plus proche de l'écran :
        un scroll rapide obtient ses images sans attendre le reste. */
    function takeNearest(pending: number[]): number {
      const c = Math.round(current);
      let best = 0;
      let bestDist = Infinity;
      for (let k = 0; k < pending.length; k++) {
        const dist = Math.abs(pending[k] - c);
        if (dist < bestDist) {
          bestDist = dist;
          best = k;
        }
      }
      return pending.splice(best, 1)[0];
    }

    function runPass(pass: number[]): Promise<unknown> {
      const pending = pass.filter((i) => !requested[i]);
      const workers = Array.from(
        { length: Math.min(CONCURRENCY, pending.length) },
        async () => {
          while (pending.length) {
            const i = takeNearest(pending);
            await load(i);
            // La nouvelle frame est-elle celle qu'il faut afficher maintenant ?
            const at = Math.round(current);
            if (frames[i] && nearestLoaded(at) === frames[i]) {
              drawn = -1;
              draw(at);
            }
          }
        },
      );
      return Promise.all(workers);
    }

    /* ---- Démarrage ---- */
    (async () => {
      resize();
      await load(0, 'high');
      draw(0);
      updateTarget();

      for (const pass of passes()) await runPass(pass);
    })();
  }
</script>
