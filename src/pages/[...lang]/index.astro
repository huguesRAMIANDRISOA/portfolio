---
import Layout from '../../layouts/Layout.astro';
import SequenceBackground from '../../components/SequenceBackground.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import { SITE } from '../../config/site';
import { UI, type Lang } from '../../i18n/ui';
import * as si from 'simple-icons';

/* Une page statique par langue. `lang: undefined` produit `/index.html` (le
   français, sans préfixe) ; `lang: 'en'` produit `/en/index.html`. */
export function getStaticPaths() {
  return [
    { params: { lang: undefined }, props: { lang: 'fr' as Lang } },
    { params: { lang: 'en' }, props: { lang: 'en' as Lang } },
  ];
}

const { lang } = Astro.props;
const t = UI[lang];

/** Les entrées sans `href` n'ont pas encore de section : rendues non cliquables. */
const NAV = [
  { label: t.nav.home, href: '#home' },
  { label: t.nav.about, href: '#about' },
  { label: t.nav.skills, href: '#skills' },
  { label: t.nav.contact, href: '#contact' },
];

/** Titres du hero, permutés toutes les 2 s (voir le script en bas de page). */
const ROLES = t.hero.roles;

const LOCATIONS = [
  { country: t.hero.country, cities: t.hero.city },
  { country: t.hero.phone, cities: '+261342827538' },
  { country: t.hero.email, cities: 'huguesramiandrisoaandrianirina@gmail.com' },
];

/* Logos officiels : `simple-icons` n'est utilisé qu'au build (chemin SVG +
   couleur de marque), rien de cette dépendance n'est envoyé au navigateur. */
const STACK = [
  si.siNodedotjs,
  si.siTailwindcss,
  si.siReact,
  si.siHtml5,
  si.siCss,
  si.siJavascript,
  si.siFlutter,
  si.siDocker,
  si.siGit,
  si.siHoudini,
];

/** Chiffres clés de la section « A propos ». `icon` = attribut `d` d'un SVG 24×24. */
const STATS = [
  {
    value: '5+',
    label: t.about.stats[0],
    icon: 'M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z',
  },
  {
    value: '10+',
    label: t.about.stats[1],
    icon: 'm16 18 6-6-6-6M8 6l-6 6 6 6',
  },
  {
    value: '10+',
    label: t.about.stats[2],
    icon: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01',
  },
  {
    value: '100%',
    label: t.about.stats[3],
    icon: 'M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22M18 2H6v7a6 6 0 0 0 12 0V2Z',
  },
];

/* Point d'envoi du formulaire : créer le formulaire sur formspree.io et coller
   son identifiant ici. Tant qu'il est vide, l'envoi est désactivé. */
const FORMSPREE_ID = 'xzepvbln';

const PHONE = '+261 34 28 275 38';
const PHONE_RAW = '261342827538';
const EMAIL = 'huguesramiandrisoaandrianirina@gmail.com';

/** Tracés `d` de SVG 24×24, partagés entre la section contact et le footer. */
const ICON = {
  phone:
    'M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z',
  chat: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10Z',
  mail: 'M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm18 2-10 7L2 6',
};

/** Moyens de contact directs. */
const CHANNELS = [
  { label: t.contact.channels[0], value: PHONE, href: `tel:+${PHONE_RAW}`, icon: ICON.phone },
  {
    label: t.contact.channels[1],
    value: PHONE,
    href: `https://wa.me/${PHONE_RAW}`,
    icon: ICON.chat,
  },
  { label: t.contact.channels[2], value: EMAIL, href: `mailto:${EMAIL}`, icon: ICON.mail },
];

/* Réseaux sociaux : remplacer les `#` par les vraies URL des profils. */
const SOCIALS = [
  { ...si.siGithub, href: '#' },
  // LinkedIn ne fait plus partie de `simple-icons` : tracé repris à la main.
  {
    title: 'LinkedIn',
    path: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14Zm1.78 13.02H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z',
    href: '#',
  },
  { ...si.siFacebook, href: '#' },
  { ...si.siInstagram, href: '#' },
];

/** Indicatifs proposés à côté du numéro de téléphone. */
const DIAL_CODES = ['+261', '+33', '+32', '+1'];

/* Habillage commun des champs : fond très peu opaque pour garder le texte
   lisible par-dessus la séquence d'images sans masquer celle-ci. */
const FIELD =
  'w-full rounded-md border border-ink-700/70 bg-ink-950/40 px-4 py-3 text-sm text-ink-50 transition-colors placeholder:text-ink-500 hover:border-ink-500 focus:border-brand-500';
const LABEL = 'mb-2 block text-xs font-bold text-ink-100';

/* Contacts repris dans le footer : le tchat n'y figure pas, l'email et le
   téléphone suffisent. */
const FOOTER_CONTACTS = [
  { value: EMAIL, href: `mailto:${EMAIL}`, icon: ICON.mail },
  { value: PHONE, href: `tel:+${PHONE_RAW}`, icon: ICON.phone },
];

/** Prestations, reprises des rôles annoncés dans le hero et la section « À propos ». */
const SERVICES = t.footer.services;

// Figé au build : le site est statique, l'année part telle quelle dans le HTML.
const YEAR = new Date().getFullYear();
---

<Layout lang={lang}>
  <SequenceBackground />

  <header class="fixed inset-x-0 top-0 z-50">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6 lg:px-10">
      <a href="#home" class="flex flex-col gap-1">
        <span class="flex items-center gap-2">
          <span class="h-px w-6 bg-brand-500"></span>
          <span class="text-xl font-black tracking-widest">HUGUES</span>
        </span>
        <span class="text-[0.6rem] tracking-[0.35em] text-ink-300">IAM FREELANCER</span>
      </a>

      <div class="flex items-center gap-6">
        <nav aria-label="Navigation principale">
          <ul class="flex items-center gap-6 text-sm">
          {
            NAV.map(({ label, href }, i) =>
              href ? (
                <li>
                  {/* `aria-current` porte l'état actif : posé ici pour la section
                      de départ, puis déplacé au défilement (script en bas de page). */}
                  <a
                    href={href}
                    data-nav-link
                    aria-current={i === 0 ? 'true' : undefined}
                    class="text-ink-100 transition-colors hover:text-brand-400 aria-[current=true]:text-brand-500"
                  >
                    {label}
                  </a>
                </li>
              ) : (
                <li class="text-ink-300/60" aria-disabled="true">
                  {label}
                </li>
              )
            )
          }
          </ul>
        </nav>

        <LanguageSwitcher lang={lang} label={t.meta.switcher} />
      </div>
    </div>
  </header>

  {/* Seul le contenu est masqué en haut de fenêtre : le fond, hors de ce
      conteneur, reste net. Voir `.fade-under-header` dans global.css. */}
  <div id="content" class="fade-under-header relative z-10">

    {/* ---------- Hero ---------- */}
    <section id="home" class="relative z-10 flex min-h-screen items-center">
      <div class="mx-auto w-full max-w-7xl px-6 lg:px-10">
        <p class="text-sm font-bold italic text-brand-500">{t.hero.intro}</p>

        <h1
          class="mt-4 min-h-[1em] text-6xl font-black uppercase leading-none tracking-tight sm:text-7xl lg:text-8xl"
        ><span
            id="hero-role"
            class="inline-block transition-all duration-300 ease-out"
            data-roles={JSON.stringify(ROLES)}>{ROLES[0]}</span><span
            class="font-light text-ink-100 motion-safe:animate-caret">|</span
          ></h1>

        <dl class="mt-10 flex flex-wrap gap-x-12 gap-y-6">
          {
            LOCATIONS.map(({ country, cities }) => (
              <div class="border-l border-ink-700 pl-4">
                <dt class="text-sm font-bold">{country}</dt>
                <dd class="mt-1 text-sm text-ink-300">{cities}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="absolute inset-x-0 bottom-12 flex justify-center">
        <span
          class="flex h-10 w-6 justify-center rounded-full border border-ink-500 pt-2"
          aria-hidden="true"
        >
          <span class="h-1.5 w-1 animate-bounce rounded-full bg-ink-300"></span>
        </span>
      </div>
    </section>

    {/* ---------- A propos ---------- */}
    <section id="about" class="relative z-10 py-32">
      <div class="mx-auto grid w-full max-w-7xl gap-16 px-6 lg:grid-cols-2 lg:items-center lg:gap-24 lg:px-10">
        <div>
          <span
            class="inline-block rounded-md bg-brand-500/10 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-[0.2em] text-brand-400 ring-1 ring-brand-500/30"
            >{t.about.badge}</span
          >

          <h2 class="mt-6 text-3xl font-black leading-tight sm:text-4xl">
            {t.about.title[0]}<br />{t.about.title[1]}
          </h2>

          <p class="mt-6 max-w-md text-sm leading-relaxed text-ink-300">{t.about.text}</p>

          {/* Mène au formulaire plutôt qu'à un `mailto:` : pas de client mail à
              ouvrir, et la carte de la section contact garde les liens directs. */}
          <a
            href="#contact"
            class="mt-10 inline-flex items-center gap-3 rounded-md border border-ink-700 px-5 py-3 text-sm font-bold transition-colors hover:border-brand-500 hover:text-brand-400"
          >
            {t.about.cta}
            <svg
              viewBox="0 0 24 24"
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        </div>

        {/* Filets tracés cellule par cellule : les cases restent transparentes
            pour laisser voir la séquence d'images en fond. */}
        <dl class="grid grid-cols-2">
          {
            STATS.map(({ value, label, icon }, i) => (
              <div
                class:list={[
                  'p-8',
                  i % 2 === 1 && 'border-l border-ink-700/60',
                  i >= 2 && 'border-t border-ink-700/60',
                ]}
              >
                <span
                  class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-500/10 text-brand-400 ring-1 ring-brand-500/20"
                  aria-hidden="true"
                >
                  <svg
                    viewBox="0 0 24 24"
                    class="h-5 w-5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d={icon} />
                  </svg>
                </span>
                <dd class="mt-6 text-3xl font-black">{value}</dd>
                <dt class="mt-1 text-sm text-ink-300">{label}</dt>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    {/* ---------- Compétences ---------- */}
    <section id="skills" class="relative z-10 py-30">
      <div class="mx-auto w-full max-w-7xl px-6 lg:px-10">
        <p class="text-center text-[0.65rem] font-bold uppercase tracking-[0.25em] text-brand-400">
          {t.skills.eyebrow}
        </p>
        <h2 class="mt-3 text-center text-3xl font-black sm:text-4xl">{t.skills.title}</h2>

        <ul class="mt-16 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-5">
          {
            STACK.map(({ title, path, hex }) => (
              <li class="flex flex-col items-center gap-4 rounded-xl border border-ink-700/50 px-4 py-8 transition-colors hover:border-ink-500">
                {/* La couleur de marque passe par `style` : une classe assemblée à
                    l'exécution ne serait jamais générée par Tailwind. */}
                <svg
                  viewBox="0 0 24 24"
                  class="h-9 w-9"
                  fill="currentColor"
                  style={`color:#${hex}`}
                  aria-hidden="true"
                >
                  <path d={path} />
                </svg>
                <span class="text-center text-sm font-bold">{title}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ---------- Contact ---------- */}
    {/* `py-20` et non `py-32` comme les autres sections : celle-ci est la plus
        haute du site, et ces 96 px de moins la font tenir dans la fenêtre — donc
        se centrer au clic (voir `anchorOf` dans le script en bas de page). */}
    <section id="contact" class="relative z-10 pt-30">
      <div class="mx-auto w-full max-w-7xl px-6 lg:px-10">
        <p class="text-center text-[0.65rem] font-bold uppercase tracking-[0.25em] text-brand-400">
          {t.contact.eyebrow}
        </p>
        <h2 class="mt-3 text-center text-3xl font-black sm:text-4xl">{t.contact.title}</h2>

        <div class="mt-16 grid gap-8 lg:grid-cols-[1fr_20rem]">
          {/* ---- Formulaire ---- */}
          <div class="rounded-2xl border border-ink-700/50 p-8 sm:p-10">
            <h3 class="text-2xl font-black">{t.contact.formTitle}</h3>
            <p class="mt-2 max-w-md text-sm leading-relaxed text-ink-300">{t.contact.formText}</p>

            {/* Formspree gère l'envoi : aucun backend à héberger. Les messages
                d'état passent par des attributs `data-` — le script est commun
                aux deux langues, il ne peut pas les contenir en dur. */}
            <form
              id="contact-form"
              action={FORMSPREE_ID ? `https://formspree.io/f/${FORMSPREE_ID}` : undefined}
              method="POST"
              class="mt-8 grid gap-6 sm:grid-cols-2"
              data-sending={t.contact.sending}
              data-ok={t.contact.ok}
              data-error={t.contact.error}
              data-offline={t.contact.offline}
            >
              {/* Objet de l'email de notification, et piège à robots : un
                  formulaire rempli automatiquement remplit aussi `_gotcha`, que
                  Formspree jette sans rien signaler à l'expéditeur. */}
              <input type="hidden" name="_subject" value={t.contact.subject} />
              <input
                type="text"
                name="_gotcha"
                class="hidden"
                tabindex="-1"
                autocomplete="off"
                aria-hidden="true"
              />
              <div>
                <label class={LABEL} for="firstname">{t.contact.firstName}</label>
                <input
                  class={FIELD}
                  id="firstname"
                  name="prenom"
                  type="text"
                  autocomplete="given-name"
                  placeholder={t.contact.firstNamePlaceholder}
                  required
                />
              </div>

              <div>
                <label class={LABEL} for="lastname">{t.contact.lastName}</label>
                <input
                  class={FIELD}
                  id="lastname"
                  name="nom"
                  type="text"
                  autocomplete="family-name"
                  placeholder={t.contact.lastNamePlaceholder}
                  required
                />
              </div>

              <div>
                <label class={LABEL} for="email">{t.contact.email}</label>
                <input
                  class={FIELD}
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  placeholder={t.contact.emailPlaceholder}
                  required
                />
              </div>

              <div>
                <label class={LABEL} for="phone">{t.contact.phone}</label>
                {/* L'indicatif est un champ à part : il part dans l'email de
                    notification à côté du numéro. */}
                <div class="flex gap-2">
                  <select
                    class="rounded-md border border-ink-700/70 bg-ink-950/40 px-3 py-3 text-sm text-ink-50 transition-colors hover:border-ink-500 focus:border-brand-500"
                    name="indicatif"
                    aria-label={t.contact.dialLabel}
                  >
                    {DIAL_CODES.map((code) => <option value={code}>{code}</option>)}
                  </select>
                  <input
                    class={FIELD}
                    id="phone"
                    name="telephone"
                    type="tel"
                    autocomplete="tel-national"
                    placeholder={t.contact.phonePlaceholder}
                  />
                </div>
              </div>

              <div class="sm:col-span-2">
                <label class={LABEL} for="message">{t.contact.message}</label>
                <textarea
                  class={`${FIELD} resize-y`}
                  id="message"
                  name="message"
                  rows="5"
                  placeholder={t.contact.messagePlaceholder}
                  required></textarea>
              </div>

              <div class="sm:col-span-2 sm:justify-self-end">
                <button
                  class="w-full rounded-md bg-brand-500 px-6 py-3 text-sm font-bold text-ink-50 transition-colors hover:bg-brand-600 disabled:cursor-not-allowed disabled:opacity-50 sm:w-auto"
                  type="submit"
                  disabled={!FORMSPREE_ID}
                >
                  {t.contact.submit}
                </button>
              </div>
            </form>

            {/* `role="status"` : le message est annoncé aux lecteurs d'écran
                sans voler le focus. Rempli par le script en bas de page. */}
            <p
              id="form-status"
              role="status"
              aria-live="polite"
              class="mt-6 hidden rounded-md border px-4 py-3 text-sm"
            >
            </p>
          </div>

          {/* ---- Contact direct ---- */}
          {/* `min-w-0` sur la carte et sur chaque ligne : sans lui, un élément de
              grille garde `min-width: auto` et l'email, trop long pour être coupé,
              élargirait la carte au-delà de sa colonne. */}
          <aside class="min-w-0 rounded-2xl border border-ink-700/50 bg-ink-900/40 p-8">
            <p class="text-lg font-black leading-snug">
              {t.contact.asideTitle[0]}<br />{t.contact.asideTitle[1]}
            </p>

            <ul class="mt-8 grid gap-3">
              {
                CHANNELS.map(({ label, value, href, icon }) => (
                  <li class="min-w-0">
                    <a
                      href={href}
                      class="flex items-center gap-4 rounded-xl border border-ink-700/50 p-4 transition-colors hover:border-brand-500/60"
                    >
                      <span
                        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-500/10 text-brand-400 ring-1 ring-brand-500/20"
                        aria-hidden="true"
                      >
                        <svg
                          viewBox="0 0 24 24"
                          class="h-5 w-5"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d={icon} />
                        </svg>
                      </span>
                      <span class="min-w-0">
                        <span class="block text-xs text-ink-300">{label}</span>
                        {/* `break-all` plutôt que `truncate` : l'adresse passe sur
                            deux lignes au lieu d'être tronquée, donc reste lisible. */}
                        <span class="block break-all text-sm font-bold">{value}</span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>

            <p class="mt-8 text-[0.65rem] font-bold uppercase tracking-[0.2em] text-ink-300">
              {t.contact.follow}
            </p>

            <ul class="mt-4 flex gap-3">
              {
                SOCIALS.map(({ title, path, href }) => (
                  <li>
                    <a
                      href={href}
                      class="flex h-10 w-10 items-center justify-center rounded-lg border border-ink-700/50 text-ink-100 transition-colors hover:border-brand-500/60 hover:text-brand-400"
                      aria-label={title}
                      rel="noopener"
                      target="_blank"
                    >
                      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
                        <path d={path} />
                      </svg>
                    </a>
                  </li>
                ))
              }
            </ul>
          </aside>
        </div>
      </div>
    </section>

    {/* ---------- Citation ---------- */}
    <section id="quote" class="relative z-10 flex min-h-screen items-center ">
      <figure class="mx-auto w-full max-w-4xl px-6 lg:px-10">
        {/* Le glyphe ne remplit que le haut de sa boîte : interlignage resserré
            pour supprimer le vide qu'il laisse au-dessus de la citation. */}
        <span class="block text-8xl font-black leading-[0.45] text-brand-500" aria-hidden="true"
          >&rdquo;</span
        >

        <blockquote class="mt-2 text-2xl leading-relaxed sm:text-3xl">{t.quote.text}</blockquote>

        <figcaption class="mt-3 border-l border-ink-500 pl-3 text-sm text-ink-300">
          Hugues RAMIANDRISOA
        </figcaption>
      </figure>
    </section>
  </div>

  {/* ---------- Footer ---------- */}
  <footer slot="footer" class="relative z-10 border-t border-ink-700/50 bg-ink-950/40">
    <div class="mx-auto w-full max-w-7xl px-6 py-16 lg:px-10">
      <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-4">
        <section>
          <h2 class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-ink-300">
            {t.footer.contact}
          </h2>

          <ul class="mt-6 grid gap-4">
            {
              FOOTER_CONTACTS.map(({ value, href, icon }) => (
                <li class="min-w-0">
                  <a
                    href={href}
                    class="flex items-start gap-3 text-sm text-ink-100 transition-colors hover:text-brand-400"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      class="mt-0.5 h-4 w-4 shrink-0 text-brand-500"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d={icon} />
                    </svg>
                    <span class="break-all">{value}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section>
          <h2 class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-ink-300">
            {t.footer.nav}
          </h2>

          {/* Mêmes entrées que le header : une seule liste à tenir à jour. */}
          <ul class="mt-6 grid gap-3">
            {
              NAV.map(({ label, href }) => (
                <li>
                  <a
                    href={href}
                    class="text-sm text-ink-100 transition-colors hover:text-brand-400"
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section>
          <h2 class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-ink-300">
            {t.footer.servicesTitle}
          </h2>

          {/* Pas de liens : ces pages n'existent pas. */}
          <ul class="mt-6 grid gap-3">
            {SERVICES.map((service) => <li class="text-sm text-ink-100">{service}</li>)}
          </ul>
        </section>

        <section>
          <h2 class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-ink-300">
            {t.footer.follow}
          </h2>

          <ul class="mt-6 flex flex-wrap gap-3">
            {
              SOCIALS.map(({ title, path, href }) => (
                <li>
                  <a
                    href={href}
                    class="flex h-10 w-10 items-center justify-center rounded-full border border-ink-700/50 text-ink-100 transition-colors hover:border-brand-500/60 hover:text-brand-400"
                    aria-label={title}
                    rel="noopener"
                    target="_blank"
                  >
                    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
                      <path d={path} />
                    </svg>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </div>

      <div
        class="mt-16 flex flex-col gap-4 border-t border-ink-700/50 pt-8 text-sm text-ink-300 sm:flex-row sm:items-center sm:justify-between"
      >
        <p>© {YEAR} {SITE.name}. {t.footer.rights}</p>

        <a href="#home" class="inline-flex items-center gap-2 transition-colors hover:text-brand-400">
          {t.footer.top}
          <svg
            viewBox="0 0 24 24"
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 19V5M5 12l7-7 7 7" />
          </svg>
        </a>
      </div>
    </div>
  </footer>
</Layout>

<script>
  /* ---- Recalage du masque de fondu sur le haut de la fenêtre ---- */
  {
    const content = document.getElementById('content');

    if (content) {
      let queued = false;

      const sync = () => {
        queued = false;
        content.style.setProperty('--fade-y', `${window.scrollY}px`);
      };

      // Une seule écriture par frame : le scroll peut émettre bien plus souvent.
      window.addEventListener(
        'scroll',
        () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(sync);
        },
        { passive: true }
      );

      sync();
    }
  }
</script>

<script>
  /* ---- Lien de navigation actif selon la section à l'écran ---- */
  {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];

    // Les liens dont l'ancre ne correspond à aucune section sont ignorés.
    const targets = links.flatMap((link) => {
      const section = document.querySelector<HTMLElement>(link.hash);
      return section ? [{ link, section }] : [];
    });

    if (targets.length) {
      // Hauteur réservée au header en haut de fenêtre.
      const HEADER = 96;

      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const activate = (active: HTMLAnchorElement) => {
        for (const { link } of targets) {
          if (link === active) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        }
      };

      /* Position de défilement où une section est « à sa place » : centrée
         dans la fenêtre si elle y tient, sinon calée sous le header — une
         section plus haute que l'écran ne peut pas être centrée sans que son
         titre sorte par le haut. Sert autant à la visée du clic qu'à la
         détection au défilement, pour que les deux ne se contredisent pas. */
      const anchorOf = (section: HTMLElement) => {
        const top = section.getBoundingClientRect().top + window.scrollY;
        const gap = Math.max(HEADER, (window.innerHeight - section.offsetHeight) / 2);
        const max = document.documentElement.scrollHeight - window.innerHeight;

        return Math.min(Math.max(top - gap, 0), Math.max(max, 0));
      };

      // Dernière section dont la position a été atteinte (la première par défaut).
      const currentTarget = () => {
        let current = targets[0];

        for (const target of targets) {
          // 1 px de marge : le défilement peut s'arrêter sur une valeur fractionnaire.
          if (anchorOf(target.section) <= window.scrollY + 1) current = target;
        }

        return current;
      };

      /* Pendant le défilement doux déclenché par un clic, les sections
         traversées ne doivent pas voler l'état actif au lien cliqué. */
      let pending: HTMLAnchorElement | null = null;
      let unlock = 0;

      let queued = false;

      const sync = () => {
        queued = false;
        const current = currentTarget();

        if (pending) {
          if (current.link !== pending) return;
          pending = null;
          clearTimeout(unlock);
        }

        activate(current.link);
      };

      window.addEventListener(
        'scroll',
        () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(sync);
        },
        { passive: true }
      );

      // Reprendre la main au doigt ou à la molette annule le verrou.
      for (const event of ['wheel', 'touchstart'] as const) {
        window.addEventListener(event, () => (pending = null), { passive: true });
      }

      /* Le saut natif alignerait le bord de la section sous le header, or ses
         marges hautes sont vides : on vise `anchorOf` à la place. Tous les liens
         d'ancre de la page sont concernés — header, logo, footer — sinon deux
         liens vers #contact n'atterriraient pas au même endroit. */
      const anchors = [...document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];

      for (const anchor of anchors) {
        // Écarte les `href="#"` (profils sociaux non renseignés), que
        // `querySelector` refuserait.
        if (anchor.hash.length < 2) continue;

        const section = document.querySelector<HTMLElement>(anchor.hash);
        // Restreint aux sections : le lien d'évitement vise `#main`, qu'on ne centre pas.
        if (!section?.matches('section[id]')) continue;

        // Rend la section atteignable par `focus()` sans l'insérer dans l'ordre de tabulation.
        section.tabIndex = -1;

        anchor.addEventListener('click', (event) => {
          event.preventDefault();

          // Le lien de header correspondant, s'il existe (#quote n'en a pas).
          const link = targets.find((target) => target.link.hash === anchor.hash)?.link;

          if (link) {
            pending = link;
            activate(link);
          }

          history.pushState(null, '', anchor.hash);
          window.scrollTo({ top: anchorOf(section), behavior: still ? 'auto' : 'smooth' });
          // `preventDefault` supprime aussi le déplacement du focus vers la cible.
          section.focus({ preventScroll: true });

          // Filet : une section que le défilement ne peut pas atteindre (bas de
          // page) ne libérerait jamais le verrou.
          clearTimeout(unlock);
          unlock = window.setTimeout(() => (pending = null), 1200);
        });
      }

      sync();
    }
  }
</script>

<script>
  /* ---- Envoi du formulaire sans quitter la page ---- */
  {
    const form = document.querySelector<HTMLFormElement>('#contact-form');
    const status = document.getElementById('form-status');
    const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    // Absente tant que `FORMSPREE_ID` est vide : on laisse alors le formulaire inerte.
    const endpoint = form?.getAttribute('action');

    if (form && status && button && endpoint) {
      const IDLE = button.textContent;
      // Traductions posées sur le formulaire : ce script sert les deux langues.
      const TEXT = form.dataset;

      /* Le rouge de marque signale l'échec ; le succès prend l'accent bleu,
         qui ne peut pas se lire comme une alerte. */
      const OK = 'border-accent-500/40 bg-accent-500/10 text-accent-400';
      const KO = 'border-brand-500/40 bg-brand-500/10 text-brand-400';

      const show = (message: string, ok: boolean) => {
        status.textContent = message;
        status.classList.remove('hidden', ...OK.split(' '), ...KO.split(' '));
        status.classList.add(...(ok ? OK : KO).split(' '));
      };

      form.addEventListener('submit', async (event) => {
        // La validation native (`required`, `type="email"`) s'est déjà exécutée :
        // ce gestionnaire ne tourne que sur un formulaire valide.
        event.preventDefault();

        button.disabled = true;
        button.textContent = TEXT.sending ?? '';
        status.classList.add('hidden');

        try {
          // `Accept: application/json` : sans cet en-tête, Formspree répond
          // par une redirection vers sa page de remerciement.
          const response = await fetch(endpoint, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });

          if (response.ok) {
            form.reset();
            show(TEXT.ok ?? '', true);
          } else {
            // Formspree détaille la cause (quota atteint, champ refusé…).
            const data = (await response.json().catch(() => null)) as {
              errors?: { message: string }[];
            } | null;

            show(
              data?.errors?.map((error) => error.message).join(' ') || TEXT.error || '',
              false
            );
          }
        } catch {
          show(TEXT.offline ?? '', false);
        } finally {
          button.disabled = false;
          button.textContent = IDLE;
        }
      });
    }
  }
</script>

<script>
  /* ---- Rotation du titre du hero ---- */
  {
    const role = document.getElementById('hero-role');
    const roles: string[] = JSON.parse(role?.dataset.roles ?? '[]');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (role && roles.length > 1 && !still) {
      const FADE = 300; // doit rester aligné sur `duration-300` du span
      let i = 0;

      setInterval(() => {
        role.classList.add('opacity-0', '-translate-y-2');
        setTimeout(() => {
          i = (i + 1) % roles.length;
          role.textContent = roles[i];
          role.classList.remove('opacity-0', '-translate-y-2');
        }, FADE);
      }, 2000);
    }
  }
</script>
