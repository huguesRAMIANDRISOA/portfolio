---
interface Props {
  id: string;
  title: string;
  /** Phrase d'accroche affichée sous le titre */
  lead?: string;
  class?: string;
}

const { id, title, lead, class: className = '' } = Astro.props;
const headingId = `${id}-title`;
---

<section id={id} aria-labelledby={headingId} class={`py-20 sm:py-28 ${className}`}>
  <div class="mx-auto w-full max-w-5xl px-5 sm:px-8">
    <h2 id={headingId} class="text-3xl font-semibold tracking-tight sm:text-4xl">
      {title}
    </h2>
    {lead && <p class="mt-3 max-w-2xl text-lg text-ink-700">{lead}</p>}
    <div class="mt-10">
      <slot />
    </div>
  </div>
</section>
